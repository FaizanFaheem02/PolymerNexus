@base <http://example.com/rml/> .

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix ex: <https://tib.eu/insuka/> .


# applications

<#ApplicationsTM>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:tableName "applications"
    ] ;

    rr:subjectMap [
        rr:template "https://tib.eu/insuka/application/{id}" ;
        rr:class ex:Application
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:name ;

        rr:objectMap [
            rr:column "name" ;
            rr:datatype xsd:string
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:deletedAt ;

        rr:objectMap [
            rr:column "deleted_at" ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:createdAt ;

        rr:objectMap [
            rr:column "created_at" ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:updatedAt ;

        rr:objectMap [
            rr:column "updated_at" ;
            rr:datatype xsd:dateTime
        ]
    ] .

# application_recipe

<#ApplicationRecipeTM>
    a rr:TriplesMap ;

    rr:logicalTable [
        rr:tableName "application_recipe"
    ] ;

    rr:subjectMap [
        rr:template "https://tib.eu/insuka/applicationRecipe/{id}" ;
        rr:class ex:ApplicationRecipe
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:belongsToApplication ;

        rr:objectMap [
            rr:parentTriplesMap <#ApplicationsTM> ;

            rr:joinCondition [
                rr:child "application_id" ;
                rr:parent "id"
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:belongsToRecipe ;

        rr:objectMap [
            rr:parentTriplesMap <#RecipesTM> ;

            rr:joinCondition [
                rr:child "recipe_id" ;
                rr:parent "id"
            ]
        ]
    ] .

